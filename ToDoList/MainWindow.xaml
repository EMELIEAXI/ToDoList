<Window x:Class="ToDoList.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ToDoList"
        mc:Ignorable="d"
        Title="To-Do-App" Height="626" Width="375">
    <Grid Margin="0,0,0,-6" Background="Gainsboro">
        <Grid.RowDefinitions>
            <RowDefinition Height="497*"/>
            <RowDefinition Height="15*"/>
        </Grid.RowDefinitions>
        <TextBox Name="TaskTextBox" HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Top" Width="355" Height="62"/>
        <Button Name="AddButton" Content="Lägg till uppgift" Background="LemonChiffon" HorizontalAlignment="Center" VerticalAlignment="Top" Width="146" Height="30" Margin="0,77,0,0" Click="AddButton_Click"/>

        <ListBox Name="TasksListBox" HorizontalAlignment="Center" Height="365" Margin="0,132,0,0" Width="355" VerticalAlignment="Top"/>
        <Button Name="RemoveButton" Content="Ta bort uppgift" Background="Coral" Foreground="Black" HorizontalAlignment="Left" VerticalAlignment="Top" Width="146" Height="30" Margin="214,502,0,0" Click="RemoveButton_Click"/>
    </Grid>
</Window>

